{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "types": ["node"],
    "lib": ["DOM", "ES6"],
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": ["**/*.ts"]
}
